  "authors": ["du"],
  "environment": "*",
  "entrypoints": {
    "main": ["com.challengemods.ChallengeMods"],
    "client": ["com.challengemods.client.ChallengeModsClient"]
  },
  "mixins": ["challengemods.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
